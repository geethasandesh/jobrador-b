PORT=4000
# Local site. On Vercel set https://jobrador-f.vercel.app so reset emails do not point at localhost.
FRONTEND_ORIGIN=http://localhost:3000

# Supabase → Project Settings → Database → Connection string → URI.
# Use the session pooler (port 5432) or the direct connection. Do not commit the real value.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Gmail address that sends password resets and receives bug reports.
# Use a Google app password, not the normal Gmail password. Do not commit the real value.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Supabase → Project Settings → API → service_role.
# Used only to build the password reset link. Do not commit it, and do not put it in the website.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel sends this when the daily ingest cron runs. Put the same value in the Vercel project settings.
CRON_SECRET=
